ackground: #2D1F18;color: #7BE1BF;font-weight: 800;font-size: 16px;width: 32px;height: 32px;border-radius: 10px;display: flex;align-items: center;justify-content: center;flex-shrink: 0}\n.step-text h3 {font-size: 16px;color: #2D1F18;margin-bottom: 4px;font-weight: 700}\n.step-text p {font-size: 14px;color: #6C5549;line-height: 1.6}\n.faq-wrap {display: flex;flex-direction: column;gap: 14px}\ndetails.faq-item {background: #FFFFFF;border-radius: 20px;padding: 20px 24px;box-shadow: 0 10px 24px rgba(45, 31, 24, 0.04);border: 1px solid rgba(45, 31, 24, 0.06)}\ndetails.faq-item summary {font-size: 16px;font-weight: 700;color: #2D1F18;cursor: pointer;list-style: none;display: flex;justify-content: space-between;align-items: center}\ndetails.faq-item summary::-webkit-details-marker {display: none}\ndetails.faq-item summary::after {content: \"+\";font-size: 20px;color: #1F7A5E;font-weight: 400}\ndetails[open].faq-item summary::after {content: \"−\"}\ndetails.faq-item p {margin-top: 14px;font-size: 14px;color: #6C5549;line-height: 1.7}\nfooter {margin-top: 72px;text-align: center;font-size: 13px;color: #8C7366}\n@media (max-width: 640px) {\n  .page-container {padding: 24px 16px 64px}\n  .hero-column {padding: 32px 20px}\n  h1.brand-title {font-size: 28px}\n  .plan-card {padding: 24px 20px}\n  .feature-list {grid-template-columns: 1fr}\n}\n</style><main class=\"page-container\">\n\n  <article class=\"hero-column\">\n    <div class=\"meta-tag\">专栏札记与配置手册</div>\n    <h1 class=\"brand-title\">GieGie云(GieGie) 接入指南与服务规格</h1>\n    <p class=\"lead-text\">\n      网络传输需要遵循既定规则。选定合适计划，导入订阅，发起连接。去除非必要的干扰，保持链路清晰利落。\n    </p>\n    <div class=\"column-body\">\n      <p>\n        日常网络接入不应包含复杂操作。多端协议标准统一，流量账单按周期结清。无需揣测参数，文档在此完整列出。\n      </p>\n      <p>\n        各梯队方案按并发设备量与月度额度严格划分。按个人或团队规模挑选对应层级即可，无需超额采买。\n      </p>\n    </div>\n    <nav class=\"inline-nav\">\n      <span>直达分区：</span>\n      <a href=\"#plans\">订阅资费</a>\n      <a href=\"#clients\">软件支持</a>\n      <a href=\"#steps\">接入流程</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </article>\n\n  <section id=\"plans\">\n    <div class=\"section-head\">\n      <div class=\"section-tag\">Tier Selection</div>\n      <h2 class=\"section-title\">订阅方案总览</h2>\n    </div>\n    <div class=\"stack-list\">\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">基础版</h3>\n          <div class=\"plan-price-wrap\">\n            <span class=\"plan-price\">¥15/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>每月 100GB 极速流量</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>支持 3 台设备同时在线</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>解锁基础流媒体</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>普通线路节点池</li>\n        </ul>\n        <div class=\"card-action\">\n          <span class=\"card-tip\">满足个人单设备日常轻量浏览。</span>\n          <a href=\"#\" class=\"card-button\">选择基础版</a>\n        </div>\n      </div>\n\n      <div class=\"plan-card featured\">\n        <span class=\"badge-featured\">推荐方案</span>\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">旗舰版</h3>\n          <div class=\"plan-price-wrap\">\n            <span class=\"plan-price\">¥35/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>每月 300GB 极速流量</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>支持 5 台设备同时在线</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>全节点原生流媒体解锁</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>IPLC 专线游戏加速优化</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"card-action\">\n          <span class=\"card-tip\">多终端主力方案，专线加速覆盖。</span>\n          <a href=\"#\" class=\"card-button\">选择旗舰版</a>\n        </div>\n      </div>\n\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">团队版</h3>\n          <div class=\"plan-price-wrap\">\n            <span class=\"plan-price\">¥85/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>每月 1000GB 极速流量</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>支持 20 台设备同时在线</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>VIP 专属高带宽节点</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>支持企业定制路由</li>\n          <li class=\"feature-item\"><span class=\"feature-dot\"></span>专属客户经理服务</li>\n        </ul>\n        <div class=\"card-action\">\n          <span class=\"card-tip\">高并发负载，面向小型工作室协作。</span>\n          <a href=\"#\" class=\"card-button\">选择团队版</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"section-head\">\n      <div class=\"section-tag\">Compatibility</div>\n      <h2 class=\"section-title\">客户端与系统适配</h2>\n    </div>\n    <div class=\"flow-card\">\n      <div class=\"step-grid\">\n        <div class=\"step-card\">\n          <div class=\"step-index\">A</div>\n          <div class=\"step-text\">\n            <h3>桌面端支持</h3>\n            <p>适配 Windows 与 macOS。获取通用核心内核，导入个人专属订阅文件，启动系统代理分流。</p>\n          </div>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">B</div>\n          <div class=\"step-text\">\n            <h3>移动端支持</h3>\n            <p>适配 iOS 与 Android 平台主流代理工具。扫描控制台二维码即可写入节点拓扑，按需切换。</p>\n          </div>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">C</div>\n          <div class=\"step-text\">\n            <h3>路由器与软路由</h3>\n            <p>支持基于 OpenWrt 等网关级组件部署。按文档配置白名单分流，全局局域网设备按规则通行。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"steps\">\n    <div class=\"section-head\">\n      <div class=\"section-tag\">Instructions</div>\n      <h2 class=\"section-title\">四步完成接入</h2>\n    </div>\n    <div class=\"flow-card\">\n      <div class=\"step-grid\">\n        <div class=\"step-card\">\n          <div class=\"step-index\">1</div>\n          <div class=\"step-text\">\n            <h3>确认周期并订阅</h3>\n            <p>结合终端数量选择基础版、旗舰版或团队版。完成对应结算。</p>\n          </div>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">2</div>\n          <div class=\"step-text\">\n            <h3>获取订阅链接</h3>\n            <p>进入用户控制面板。复制专属于当前账户的加密订阅 URL。</p>\n          </div>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">3</div>\n          <div class=\"step-text\">\n            <h3>同步远程节点列表</h3>\n            <p>粘贴至本地客户端配置栏。点击更新，下载完整线路信息。</p>\n          </div>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">4</div>\n          <div class=\"step-text\">\n            <h3>选择分流并开启运行</h3>\n            <p>建议选择规则分流模式。点击启动开关，开始网络访问。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"section-head\">\n      <div class=\"section-tag\">Q&amp;A</div>\n      <h2 class=\"section-title\">常见问题解答</h2>\n    </div>\n    <div class=\"faq-wrap\">\n      <details class=\"faq-item\">\n        <summary>每个方案的设备连接数如何计算？</summary>\n        <p>设备数指同时向节点发起连接的客户端总数。超出额度可能导致连接握手失败。离线后名额自动释放。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>月度流量额度在什么时候重置？</summary>\n        <p>根据您的账单周期生效日逐月重置。未用完的流量不会滚入下一个计费周期。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>订阅链接泄露后应当如何处理？</summary>\n        <p>进入后台控制台点击重新生成订阅。旧链接即刻作废，避免产生异常带宽消耗。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>如何选择合适的路由规则？</summary>\n        <p>日常建议开启规则分流模式。本地局域网与国内站点直接连通，目标域名按需经由节点转发。</p>\n      </details>\n    </div>\n  </section>\n\n  <footer>\n    <p>© GieGie云(GieGie) 方案索引与配置文档 保留所有权利</p>\n  </footer>\n\n</main>",
